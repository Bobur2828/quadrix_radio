# ============================================================
# Django Base Project — Environment Variables Example
# ============================================================
# Bu faylni nusxa olib `.env` deb nomlang va o'z qiymatlaringizni kiriting:
#   cp .env.example .env
# ============================================================


# ======================== CORE DJANGO ========================

# Django maxfiy kaliti. Production'da albatta yangi va murakkab kalit yarating.
# Yangi kalit yaratish uchun:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

# Debug rejimi. Production'da DOIM `False` bo'lishi kerak!
DEBUG=True

# Ruxsat etilgan hostlar (vergul bilan ajrating).
# Misol: ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1
ALLOWED_HOSTS=*


# ======================== DATABASE ========================

# True bo'lsa PostgreSQL, False bo'lsa SQLite ishlatiladi.
USE_POSTGRES=False

# PostgreSQL sozlamalari (faqat USE_POSTGRES=True bo'lganda kerak)
DB_NAME=django_base
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432


# ======================== FEATURE FLAGS ========================

# django-silk (so'rovlar profiling) yoqilsinmi? Live broadcast uchun False qoldiring —
# Silk har request'ga overhead qo'shadi va SQLite'ga yozish stream'ni sekinlashtiradi.
ENABLE_SILK=False

# Loglarni faylga yozish yoqilsinmi?
LOGGING_STATUS=True


# ======================== CORS ========================

# True bo'lsa hammaga ruxsat (faqat development uchun!)
CORS_ALLOW_ALL_ORIGINS=True

# Aniq domenlar (vergul bilan). CORS_ALLOW_ALL_ORIGINS=False bo'lganda ishlaydi.
# Misol: CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# CSRF — production'da Django HTTPS origin'larini bilishi shart, aks holda
# admin login va boshqa POST so'rovlar 403 beradi.
# Misol: CSRF_TRUSTED_ORIGINS=https://radio.sanbax.uz
CSRF_TRUSTED_ORIGINS=

# HSTS (HTTPS-only enforcement) — sertifikat o'rnatilgandan keyin yoqing.
# 0 → o'chirilgan; 31536000 → 1 yil
SECURE_HSTS_SECONDS=0


# ======================== ADMIN PANEL (UNFOLD) ========================

SITE_TITLE=Django Base
SITE_HEADER=Django Base Admin


# ======================== LOCALIZATION ========================

LANGUAGE_CODE=en-us
TIME_ZONE=UTC


# ======================== REDIS & CELERY ========================

# Redis (broker uchun)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Agar Redis'da parol bo'lsa kiriting (default — bo'sh)
REDIS_PASSWORD=

# Celery broker URL'i. Agar yuqoridagi REDIS_* qiymatlardan tuzilsa avtomatik to'ladi.
# Aniq berish ham mumkin: redis://:password@localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Toza local rivojlanish uchun Celery'ni "eager" rejimda yoqish (taskni darhol bajaradi,
# brokersiz). True bo'lsa Redis kerak emas.
CELERY_TASK_ALWAYS_EAGER=False


# ======================== RADIO PLATFORM ========================

# Audio upload chegaralari (bytes)
RADIO_AUDIO_MAX_BYTES=524288000

# Hot API endpoint cache TTL (sekundlarda)
RADIO_CACHE_TTL_CURRENT=4
RADIO_CACHE_TTL_STATUS=8
RADIO_CACHE_TTL_PLAYLIST=45

# Icecast (admin/status o'qish uchun)
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=hackme
ICECAST_PUBLIC_BASE=http://localhost:8000

# Liquidsoap telnet boshqaruvi
LIQUIDSOAP_HOST=127.0.0.1
LIQUIDSOAP_PORT=1234
LIQUIDSOAP_PLAYLIST_DIR=

# Listener session
LISTENER_SESSION_TTL=180
LISTENER_HEARTBEAT_INTERVAL=30

# Throttling
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_HEARTBEAT=60/min

# Beat scheduler periodik tasklarni avtomatik qo'shadimi
RADIO_BEAT_ENABLED=True


# ======================== PUSH NOTIFICATIONS ========================

# Firebase Cloud Messaging (Android va iOS uchun ham ishlatish mumkin)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Apple Push (token-based, .p8 key)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=True


# ======================== GEO ========================

# MaxMind GeoLite2-City.mmdb fayl yo'li (regional playlist uchun ixtiyoriy)
GEOIP_DATABASE=
