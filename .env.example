# ============================================================
# Django Base Project — Environment Variables Example
# ============================================================
# Bu faylni nusxa olib `.env` deb nomlang va o'z qiymatlaringizni kiriting:
#   cp .env.example .env
# ============================================================


# ======================== CORE DJANGO ========================

# Django maxfiy kaliti. Production'da albatta yangi va murakkab kalit yarating.
# Yangi kalit yaratish uchun:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

# Debug rejimi. Production'da DOIM `False` bo'lishi kerak!
DEBUG=True

# Ruxsat etilgan hostlar (vergul bilan ajrating).
# Misol: ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1
ALLOWED_HOSTS=*


# ======================== DATABASE ========================

# True bo'lsa PostgreSQL, False bo'lsa SQLite ishlatiladi.
USE_POSTGRES=False

# PostgreSQL sozlamalari (faqat USE_POSTGRES=True bo'lganda kerak)
DB_NAME=django_base
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432


# ======================== FEATURE FLAGS ========================

# django-silk (so'rovlar profiling) yoqilsinmi?
ENABLE_SILK=True

# Loglarni faylga yozish yoqilsinmi?
LOGGING_STATUS=True


# ======================== CORS ========================

# True bo'lsa hammaga ruxsat (faqat development uchun!)
CORS_ALLOW_ALL_ORIGINS=True

# Aniq domenlar (vergul bilan). CORS_ALLOW_ALL_ORIGINS=False bo'lganda ishlaydi.
# Misol: CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=


# ======================== ADMIN PANEL (UNFOLD) ========================

SITE_TITLE=Django Base
SITE_HEADER=Django Base Admin


# ======================== LOCALIZATION ========================

LANGUAGE_CODE=en-us
TIME_ZONE=UTC


# ======================== REDIS & CELERY ========================

# Redis (broker uchun)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Agar Redis'da parol bo'lsa kiriting (default — bo'sh)
REDIS_PASSWORD=

# Celery broker URL'i. Agar yuqoridagi REDIS_* qiymatlardan tuzilsa avtomatik to'ladi.
# Aniq berish ham mumkin: redis://:password@localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Toza local rivojlanish uchun Celery'ni "eager" rejimda yoqish (taskni darhol bajaradi,
# brokersiz). True bo'lsa Redis kerak emas.
CELERY_TASK_ALWAYS_EAGER=False
